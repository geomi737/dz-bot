# Скопируй в .env и заполни. Файл .env никому не отправлять и не коммитить.

# Доступ к Дневник.ру. Основной способ — OAuth-токен (работает и при входе
# через Госуслуги): залогиниться на https://login.dnevnik.ru, открыть
# https://login.dnevnik.ru/oauth2?response_type=token&client_id=b8006d75-70a9-4291-885c-13d8511bb2ae&scope=CommonInfo,EducationalInfo
# нажать «Разрешить» и скопировать значение access_token из адресной строки.
DNEVNIK_TOKEN=

# Перед разрешением доступа проверь название OAuth-приложения и его права.
# Логин, пароль и куки фетчер не использует.

# Необязательно: явные id, если автоопределение не сработает
DNEVNIK_PERSON_ID=
DNEVNIK_SCHOOL_ID=

# Группа в WhatsApp: точное название или id группы (id надёжнее)
GROUP_NAME=
GROUP_ID=

# Часовой пояс школы: до 10:00 ДЗ на сегодня, с 10:00 — строго на завтра.
# По умолчанию Europe/Moscow, не зависит от часового пояса сервера.
BOT_TIMEZONE=Europe/Moscow

# Необязательно: путь к Python 3 (сторонние Python-пакеты не нужны)
# PYTHON=python3

# Если Chrome уже установлен, Puppeteer может использовать его без скачивания:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Необязательно: другой готовый Docker-образ (по умолчанию GHCR, тег latest)
# BOT_IMAGE=ghcr.io/geomi737/dz-bot:latest
